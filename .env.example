# Docker Compose reads this root file, not backend/.env. Copy with:
# cp .env.example .env
# Defaults match Laravel and PHPUnit. Pair overrides as noted below.

# Also change DB_PORT in backend/.env.
DB_PORT=3306
# Also change matching values in backend/.env. Full volume reset required.
DB_DATABASE=ticket_management
DB_USERNAME=ticket_user
DB_PASSWORD=secret
# Container initialization only.
DB_ROOT_PASSWORD=root_secret
# Also change DB_PORT in backend/phpunit.xml.
DB_TEST_PORT=3307
# Also change DB_DATABASE in backend/phpunit.xml. Full volume reset required.
DB_TEST_DATABASE=ticket_management_test
# Also change MAIL_PORT in backend/.env.
MAILPIT_SMTP_PORT=1025
# Browser-only port.
MAILPIT_UI_PORT=8025
