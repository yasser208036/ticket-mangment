<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>

        <!--
            Without this, $this->seed() with no argument throws (AdminUserSeeder
            aborts on a blank password) unless a developer's ambient .env happens
            to leak ADMIN_PASSWORD through. Setting it here makes the suite
            self-contained. Distinct from UserFactory's own literal 'password'
            default so the two are never confused in a test asserting on either.
        -->
        <env name="ADMIN_PASSWORD" value="testing-admin-password"/>

        <!--
            Tests run against the real database engine, not SQLite in memory.
            The schema uses engine-specific features (a FULLTEXT index, ENUM
            columns, ON DELETE RESTRICT), and SQLite would silently accept
            queries that production rejects — passing tests would prove nothing.

            This is the second container in docker-compose.yml, on port 3307, so
            the suite's RefreshDatabase never truncates your development data.
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3307"/>
        <env name="DB_DATABASE" value="ticket_management_test"/>
        <env name="DB_USERNAME" value="ticket_user"/>
        <env name="DB_PASSWORD" value="secret"/>
        <env name="DB_URL" value=""/>

        <env name="MAIL_MAILER" value="array"/>

        <!--
            The queue is exercised, not bypassed. Under "sync" a queued mailable
            runs inline inside the request, so a test asserting a notification
            was *queued* would pass against code that sends it synchronously —
            which is exactly what TM-52 and TM-57 forbid. RefreshDatabase
            migrates jobs, job_batches and failed_jobs like any other table and
            rolls their rows back with everything else.
        -->
        <env name="QUEUE_CONNECTION" value="database"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
