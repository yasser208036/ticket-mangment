APP_NAME="Ticket Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 from docker-compose.yml at the repo root.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ticket_management
DB_USERNAME=ticket_user
DB_PASSWORD=secret

# The test suite points at the second MySQL container so running tests never
# truncates the data you are developing against. See phpunit.xml.
DB_TEST_HOST=127.0.0.1
DB_TEST_PORT=3307
DB_TEST_DATABASE=ticket_management_test

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Notifications are queued. In development run: php artisan queue:work
QUEUE_CONNECTION=database

CACHE_STORE=database

# Mailpit from docker-compose.yml — catches every outgoing email locally.
# Read the mail at http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="helpdesk@ticket-management.test"
MAIL_FROM_NAME="${APP_NAME}"

# Where the Vue SPA runs. Used for CORS and for links inside notification emails.
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# Credentials for the admin created by DatabaseSeeder. Change before any real use.
ADMIN_NAME="Admin"
ADMIN_EMAIL=admin@ticket-management.test
ADMIN_PASSWORD=password

# A ticket with no activity for this many hours is flagged stale by
# `php artisan tickets:flag-stale` (scheduled hourly).
TICKETS_STALE_AFTER_HOURS=48
