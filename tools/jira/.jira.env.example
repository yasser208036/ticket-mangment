# Copy to .jira.env and fill in. .jira.env is git-ignored — never commit the token.
#
# Create a token at:
#   https://id.atlassian.com/manage-profile/security/api-tokens

JIRA_BASE_URL=https://notes-mangment.atlassian.net
JIRA_EMAIL=your-atlassian-account@example.com
JIRA_API_TOKEN=paste-your-api-token-here
JIRA_PROJECT_KEY=TM
